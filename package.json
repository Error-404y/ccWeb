{
  "name": "qzu-messenger",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test",
    "backup:private": "node --env-file-if-exists=.env scripts/privacy-backup.mjs",
    "reset-pin": "node --env-file-if-exists=.env scripts/reset-pin.mjs",
    "admin-list": "node --env-file-if-exists=.env scripts/admin-list.mjs",
    "admin-message": "node --env-file-if-exists=.env scripts/admin-message.mjs",
    "admin-announce": "node --env-file-if-exists=.env scripts/admin-announce.mjs",
    "admin-key": "node --env-file-if-exists=.env scripts/access.mjs admin-create",
    "access-create": "node --env-file-if-exists=.env scripts/access.mjs create",
    "access-invoices": "node --env-file-if-exists=.env scripts/access.mjs invoices",
    "access-review": "node --env-file-if-exists=.env scripts/access.mjs review",
    "access-approve": "node --env-file-if-exists=.env scripts/access.mjs approve",
    "access-reject": "node --env-file-if-exists=.env scripts/access.mjs reject",
    "mobile:prepare": "node scripts/mobile-prepare.mjs",
    "mobile:ios": "npm run mobile:prepare -- ios && npx cap open ios",
    "mobile:android": "npm run mobile:prepare -- android && npx cap open android",
    "admin-support-start": "node --env-file-if-exists=.env scripts/admin-support.mjs start",
    "admin-support-list": "node --env-file-if-exists=.env scripts/admin-support.mjs list",
    "admin-support-send": "node --env-file-if-exists=.env scripts/admin-support.mjs send",
    "release:android": "bash scripts/release-android.sh",
    "release:play": "bash scripts/release-play.sh",
    "deploy:oracle": "bash scripts/deploy-oracle.sh",
    "mobile:update": "bash scripts/update-mobile.sh",
    "publish:release": "bash scripts/publish-release.sh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "jsqr": "^1.4.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0"
  }
}
